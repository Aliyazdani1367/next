# Public gateway/listener.
# The Go gateway intentionally uses the historical UVICORN_* names.
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# NEXT_GATEWAY_ADDR = ":8000"

# Gateway TLS.
# UVICORN_SSL_CERTFILE = "/var/lib/next/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/next/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# Database.
# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"

# Binary/install metadata.
# NEXT_INSTALL_MODE = "binary"
# NEXT_SCRIPT_BIN = "/usr/local/bin/next"
# NEXT_APP_DIR = "/opt/next"
# NEXT_DATA_DIR = "/var/lib/next"
# NEXT_SERVICE_NAME = "next"

# Initial admin bootstrap.

# Node operations and user lifecycle jobs.
# NEXT_NODE_OPERATIONS_POLL_INTERVAL = "15s"
# NEXT_NODE_USAGE_COLLECTION_INTERVAL = "30s"
# NEXT_NODE_USAGE_COLLECTION_LIMIT = 0
# NEXT_USER_LIFECYCLE_INTERVAL = "10s"
# NEXT_USER_LIFECYCLE_BATCH_SIZE = 500
# NEXT_USER_USAGE_RESET_INTERVAL = "1h"
# NEXT_USER_USAGE_RESET_BATCH_SIZE = 500
# NEXT_USER_AUTODELETE_INTERVAL = "1h"
# NEXT_USER_AUTODELETE_BATCH_SIZE = 500
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

# API behavior.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# USERS_LIST_TIMEOUT_SECONDS = 0

# Settings, templates, certificates, and backup roots.
# NEXT_CERT_BASE = "/var/lib/next/certs"
# NEXT_CONFIG_DIR = "/etc/next"
